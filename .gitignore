# Ignore everything by default
*

# But keep directories, so Git can descend into them
!*/

# Keep source / script / docs
!*.py
!*.sh
!*.md

# Keep config / text
!*.yaml
!*.txt
!*.json

# Keep images
!*.png

# Keep gitignore itself
!.gitignore

# setup.py output must never be kept partially; importlib treats it as a package.
metadrive_simulator.egg-info/

# Keep generated run artifacts out of Git at any directory depth
outputs/
