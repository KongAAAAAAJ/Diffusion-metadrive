{
  "format": "chassis_execution_reward_protocol_v1",
  "schema_version": 1,
  "input": {
    "trajectory": "tau_cmd only",
    "command_shape": [1, 4, 3, 8, 3],
    "surrogate_checkpoint": "strict frozen chassis_execution_surrogate_ensemble_v1",
    "raw_tau_d_allowed": false
  },
  "execution": {
    "surrogate_inference_mode": true,
    "surrogate_parameter_updates": 0,
    "reward_gradient_through_surrogate": false,
    "metadrive_candidate_branches": 0,
    "geometric_fallback": false,
    "geometric_reward_trajectory": "predicted tau_a downsampled at 0.5 seconds"
  },
  "hard_gates": {
    "lateral_acceleration_mps2": 6.0,
    "yaw_rate_rad_s": 1.0,
    "absolute_roll_rad": 0.25,
    "absolute_rollover_index": 0.8,
    "maximum_spatial_uncertainty_std_m": 2.0,
    "unsafe_reward": "strictly below -20"
  },
  "safe_reward": {
    "range": [-5.0, 5.0],
    "base": "existing joint geometric reward evaluated on tau_a",
    "penalties": [
      "chassis comfort",
      "roll and rollover stability",
      "control effort",
      "surrogate uncertainty"
    ]
  },
  "output": {
    "rewards": [1, 4],
    "dtype": "float32",
    "requires_grad": false,
    "credit_assignment_action": "raw tau_d rollout log probability in CF-6"
  },
  "diagnostic_override": {
    "synthetic_checkpoint_allowed_only_with_explicit_opt_in": true,
    "eligible_for_formal_training": false
  }
}
